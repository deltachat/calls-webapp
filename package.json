{
  "name": "@deltachat/calls-webapp",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "vite": "vite --port 3000",
    "start": "concurrently \"npm run vite\" \"webxdc-dev run http://localhost:3000\"",
    "fix": "prettier --write .",
    "check": "tsc && prettier --check .",
    "build": "tsc && vite build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@iconify/json": "^2.2.562",
    "@preact/preset-vite": "^2.10.6",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/react": "^19.3.3",
    "@webxdc/vite-plugins": "latest",
    "@webxdc/webxdc-dev": "latest",
    "concurrently": "^10.0.7",
    "prettier": "latest",
    "typescript": "latest",
    "unplugin-icons": "^24.0.0",
    "vite": "latest",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
